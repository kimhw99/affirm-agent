# Lists every environment variable the services read, with placeholder values only.
# Never put real values here. Copy it to .env (git-ignored) and fill in real values:
#   cp .env.example .env
# OPAI_API_KEY=sk-XXX

# ---- Agent service (services/agent) ----
# The Lead uses an LLM only for judgment calls; without a key it runs deterministic fallbacks.
# (OPAI_API_KEY above is also accepted, for compatibility.)
OPENAI_API_KEY=sk-XXX
LEAD_MODEL=gpt-4o-mini
# Set to "off" to force the deterministic Lead even when a key is present (tests, evaluation baseline).
LEAD_LLM=
CASE_SERVICE_URL=http://case:8000
CASE_SERVICE_TOKEN=
# "0" disables sending the final decision back to the case service (local demos).
SEND_RESULTS=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
