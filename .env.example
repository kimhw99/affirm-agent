# Lists every environment variable the services read, with placeholder values only.
# Never put real values here. Copy it to .env (git-ignored) and fill in real values:
#   cp .env.example .env

# --- Agent service: LLM (OpenAI, via langchain-openai) ---
# With OPENAI_API_KEY empty, the agent runs without an LLM: the Lead uses its rules
# only, and the workers report that they couldn't check anything.
# OPENAI_MODEL empty: the Lead and the workers both use gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The Lead (services/agent/README.md): its own model, if it should differ from
# OPENAI_MODEL; "off" to keep it from calling the LLM even with a key; 0 to not send
# the final decision to the case service (local demos).
LEAD_MODEL=
LEAD_LLM=on
SEND_RESULTS=1
# LangFuse tracing, off while the keys are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Agent service: case service (read endpoints, docs/case-service-endpoints.md) ---
# Inside Docker Compose the agent reaches the case service by its service name;
# empty, the agent and the workers both default to http://case:8000.
CASE_SERVICE_URL=http://case:8000
# The token the agent sends and the case service checks. Until the auth service
# issues service JWTs (BEAC-14), it's a shared secret: use a long random string.
CASE_SERVICE_TOKEN=XXX

# PostgreSQL. The database container reads POSTGRES_PASSWORD (its superuser), and
# db/init.sql reads the other three when it creates each service's account.
POSTGRES_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
CASE_DB_PASSWORD=change-me
AGENT_DB_PASSWORD=change-me
# The port on this machine where docker compose publishes the database; the seed
# script (services/case/seed.py) connects to it. Change it if 55432 is taken.
POSTGRES_HOST_PORT=55432

# --- Case service ---
# The port on this machine where docker compose publishes the case service. Inside
# Docker Compose, the agent uses CASE_SERVICE_URL instead.
CASE_HOST_PORT=8001
# docker-compose.yml points the case service at the database (CASE_DB_HOST=db,
# CASE_DB_PORT=5432). Run on this machine, it and seed.py default to localhost and
# POSTGRES_HOST_PORT.

# --- Auth service and gateway (docs/auth.md) ---
# Signs the JWTs the auth service issues and the gateway checks. At least 32
# characters, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
# How long a login lasts, in minutes.
JWT_TTL_MINUTES=480
# Passwords of the demo users the auth service creates: "analyst" (role analyst) and
# "senior" (role senior_analyst). Leave one empty to skip that user.
DEMO_ANALYST_PASSWORD=change-me
DEMO_SENIOR_PASSWORD=change-me
# The port on this machine where docker compose publishes the gateway, the only
# backend service the browser reaches.
GATEWAY_HOST_PORT=8080

# --- Review app ---
# The port on this machine where docker compose publishes the review app.
APP_HOST_PORT=3000
